<?xml version="1.0" encoding="utf-8"?>
<!--
  Il server di ingest CoLF gira sul Raspberry Pi ed è raggiungibile solo
  tramite la VPN WireGuard, su indirizzi privati (es. 10.0.0.0/24,
  192.168.0.0/16) senza TLS. Invece di abilitare il cleartext ovunque con
  usesCleartextTraffic="true", lo permettiamo solo verso i range privati
  usati dalla VPN/LAN di casa: il traffico verso host pubblici resta
  vincolato a HTTPS.
-->
<network-security-config>
    <!--
      NetworkSecurityConfig non supporta range CIDR, solo host/domini
      espliciti: elenchiamo gli indirizzi noti del Pi (VPN e LAN) più
      localhost per test da adb reverse. Se l'IP VPN del server cambia,
      va aggiornato qui e ricompilata l'app.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.0.2</domain>
        <domain includeSubdomains="false">192.168.1.147</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
